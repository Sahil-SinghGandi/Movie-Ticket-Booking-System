        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Movie {\n  -title : String\n  -language : String\n  -duration : int\n  +getTitle() : String\n  +getLanguage() : String\n  +getDuration() : int\n}\n\nclass Seat {\n  -seatNumber : String\n  -seatType : SeatType\n  +getSeatNumber() : String\n  +getSeatType() : SeatType\n}\n\nclass Screen {\n  -screenNumber : int\n  -seats : List~Seat~\n  +getScreenNumber() : int\n  +getSeats() : List~Seat~\n}\n\nclass Cinema {\n  -name : String\n  -screens : List~Screen~\n  +getName() : String\n  +getScreens() : List~Screen~\n}\n\nclass Show {\n  -movie : Movie\n  -screen : Screen\n  -startTime : String\n  -showSeats : List~ShowSeat~\n  +getMovie() : Movie\n  +getScreen() : Screen\n  +getStartTime() : String\n  +getShowSeats() : List~ShowSeat~\n}\n\nclass ShowSeat {\n  -seat : Seat\n  -status : SeatStatus\n  +getSeat() : Seat\n  +getStatus() : SeatStatus\n  +bookSeat() : void\n  +cancelSeat() : void\n}\n\nclass Customer {\n  -name : String\n  -phone : String\n  +getName() : String\n  +getPhone() : String\n}\n\nclass Booking {\n  -bookingId : int\n  -show : Show\n  -showSeats : List~ShowSeat~\n  -totalAmount : double\n  -status : BookingStatus\n  +getBookingId() : int\n  +getShow() : Show\n  +getShowSeats() : List~ShowSeat~\n  +getTotalAmount() : double\n  +getStatus() : BookingStatus\n  +cancelBooking() : void\n}\n\nclass Payment {\n  &lt;&lt;abstract&gt;&gt;\n  +pay(amount : double) : boolean\n}\n\nclass UpiPayment {\n  +pay(amount : double) : boolean\n}\n\nclass CardPayment {\n  +pay(amount : double) : boolean\n}\n\nclass CashPayment {\n  +pay(amount : double) : boolean\n}\n\nclass PriceCalculator {\n  +calculateTotal(seats : List~Seat~) : double\n}\n\nclass TicketPrinter {\n  +printTicket(booking : Booking) : void\n}\n\nclass BookingService {\n  +listMovies() : void\n  +listShows(movie : Movie) : void\n  +showSeats(show : Show) : void\n  +bookSeats() : Booking\n  +makePayment(payment : Payment) : boolean\n  +cancelBooking() : void\n}\n\nCinema \&quot;1\&quot; *-- \&quot;1..*\&quot; Screen\nScreen \&quot;1\&quot; *-- \&quot;1..*\&quot; Seat\nShow \&quot;1\&quot; o-- \&quot;1\&quot; Movie\nShow \&quot;1\&quot; -- \&quot;1\&quot; Screen\nShow \&quot;1\&quot; *-- \&quot;1..*\&quot; ShowSeat\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Booking\nBooking \&quot;1\&quot; o-- \&quot;1..*\&quot; ShowSeat\nBooking \&quot;1\&quot; -- \&quot;0..*\&quot; Payment\nPayment &lt;|.. UpiPayment\nPayment &lt;|.. CardPayment\nPayment &lt;|.. CashPayment\nBookingService \&quot;1\&quot; -- \&quot;0..*\&quot; Booking\nBookingService ..&gt; PriceCalculator : uses\nBookingService ..&gt; TicketPrinter : uses\n\nnote for PriceCalculator \&quot;Seat prices:&lt;br/&gt;SILVER = ₹150&lt;br/&gt;GOLD = ₹250&lt;br/&gt;PLATINUM = ₹400\&quot;\n\nnote for Payment \&quot;Payment methods:&lt;br/&gt;UPI, Card, Cash\&quot;\n\nnote \&quot;Legend:&lt;br/&gt;◆ Composition&lt;br/&gt;◇ Aggregation&lt;br/&gt;→ Association&lt;br/&gt;- - -&gt; Dependency&lt;br/&gt;- - -▷ Inheritance&lt;br/&gt;1, 0..*, 1..* = Multiplicity\&quot; as Legend&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
