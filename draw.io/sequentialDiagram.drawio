        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    participant Customer\n    participant BookingService\n    participant Show\n    participant ShowSeat\n    participant PriceCalculator\n    participant Payment as \&quot;Payment&lt;br/&gt;&lt;&lt;abstract/interface&gt;&gt;\&quot;\n    participant Booking\n    participant TicketPrinter\n\n    Customer-&gt;&gt;+BookingService: selectShow(movieId)\n    BookingService-&gt;&gt;+Show: getShows(movieId)\n    Show--&gt;&gt;-BookingService: showList\n    BookingService--&gt;&gt;-Customer: displayShows()\n\n    Customer-&gt;&gt;+BookingService: chooseShow(showId)\n    Customer-&gt;&gt;BookingService: chooseSeat(seatNumber)\n    BookingService-&gt;&gt;+Show: getShowSeat(seatNumber)\n    Show--&gt;&gt;-BookingService: ShowSeat\n    BookingService-&gt;&gt;+ShowSeat: isAvailable()\n    ShowSeat--&gt;&gt;-BookingService: true\n    BookingService-&gt;&gt;+PriceCalculator: calculateTotal([seat])\n    PriceCalculator--&gt;&gt;-BookingService: totalAmount\n    BookingService-&gt;&gt;ShowSeat: bookSeat()\n    Customer-&gt;&gt;BookingService: choosePaymentMethod(UPI)\n\n    BookingService-&gt;&gt;+Payment: &lt;&lt;create&gt;&gt; UpiPayment\n    BookingService-&gt;&gt;Payment: pay(amount)\n    Payment--&gt;&gt;-BookingService: paymentSuccessful\n\n    BookingService-&gt;&gt;+Booking: &lt;&lt;create&gt;&gt; Booking\n    BookingService-&gt;&gt;Booking: confirm()\n    BookingService-&gt;&gt;+TicketPrinter: printTicket(booking)\n    TicketPrinter--&gt;&gt;-BookingService: ticketPrinted\n    BookingService--&gt;&gt;-Customer: showSuccess(bookingId)\n\n    alt Seat already booked\n        BookingService--&gt;&gt;Customer: showError(\&quot;Seat already BOOKED\&quot;)\n    else Payment failed\n        Payment--&gt;&gt;BookingService: false\n        BookingService-&gt;&gt;ShowSeat: release()\n        BookingService-&gt;&gt;Booking: fail()\n        BookingService--&gt;&gt;Customer: showError(\&quot;Payment failed\&quot;)\n    end\n\n    Note over Customer,TicketPrinter: Use Case: Customer books 1 seat and pays by UPI.&lt;br/&gt;A failed payment releases the selected seat and does not confirm the booking.&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
